services:

  laravel:
    build:
      context: ./laravel-api
      dockerfile: Dockerfile

    container_name: agasaja-laravel

    ports:
      - "8000:80"

    environment:
      DB_CONNECTION: ${DB_CONNECTION}
      DB_HOST: ${DB_HOST}
      DB_PORT: ${DB_PORT}
      DB_DATABASE: ${DB_DATABASE}
      DB_USERNAME: ${DB_USERNAME}
      DB_PASSWORD: ${DB_PASSWORD}

    extra_hosts:
      - "host.docker.internal:host-gateway"
      
  react:
    build:
      context: ./reactfront
      dockerfile: Dockerfile
      args:
        HTTP_PROXY: ${HTTP_PROXY}
        HTTPS_PROXY: ${HTTPS_PROXY}
    container_name: agasaja-react
    ports:
      - "8080:80"      
      
